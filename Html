<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Frozen Storm Club</title>

<meta name="description"
content="Frozen Storm Club official website. Team, players, matches, results and statistics.">

<style>
*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}

html{
    scroll-behavior:smooth;
}

body{
    font-family:Arial,Helvetica,sans-serif;
    background:#050b13;
    color:#eef8ff;
}

/* NAVBAR */

nav{
    position:sticky;
    top:0;
    z-index:1000;
    background:rgba(5,11,19,.96);
    border-bottom:1px solid #1a3045;
}

.nav{
    max-width:1150px;
    margin:auto;
    min-height:70px;
    display:flex;
    align-items:center;
    padding:0 20px;
}

.logo{
    display:flex;
    align-items:center;
    gap:10px;
    font-weight:bold;
    letter-spacing:1px;
}

.logo img{
    width:42px;
    height:48px;
    object-fit:contain;
}

.menu{
    margin-left:auto;
    display:flex;
    gap:8px;
}

.menu a{
    color:#91a8bb;
    text-decoration:none;
    padding:10px;
    font-size:13px;
}

.menu a:hover{
    color:white;
}

/* HERO */

.hero{
    max-width:1150px;
    margin:auto;
    min-height:570px;
    display:grid;
    grid-template-columns:1fr 1fr;
    align-items:center;
    padding:70px 25px;
}

.heroText small{
    color:#86d5ff;
    letter-spacing:4px;
    font-weight:bold;
}

.heroText h1{
    font-size:70px;
    line-height:.95;
    margin:18px 0;
}

.heroText p{
    color:#8fa5b8;
    max-width:540px;
    line-height:1.7;
}

.buttons{
    margin-top:25px;
    display:flex;
    gap:10px;
}

.btn{
    border:1px solid #29445c;
    background:#0b1826;
    color:white;
    padding:12px 18px;
    border-radius:8px;
    cursor:pointer;
    text-decoration:none;
    font-weight:bold;
}

.btn:hover{
    background:#12263a;
}

.primary{
    background:#dff5ff;
    color:#06101a;
}

.primary:hover{
    background:white;
}

.heroLogo{
    text-align:center;
}

.heroLogo img{
    width:320px;
    max-width:80%;
    filter:drop-shadow(0 15px 35px rgba(72,180,245,.2));
}

/* GENERAL */

section{
    max-width:1150px;
    margin:auto;
    padding:65px 25px;
}

.title{
    margin-bottom:25px;
}

.title h2{
    font-size:30px;
}

.title p{
    color:#71899d;
    margin-top:6px;
}

/* STATS */

.stats{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:14px;
}

.card{
    background:#0b1724;
    border:1px solid #1a3045;
    border-radius:12px;
    padding:20px;
}

.stat strong{
    display:block;
    font-size:32px;
}

.stat span{
    color:#7890a3;
    font-size:11px;
    text-transform:uppercase;
    letter-spacing:1px;
}

/* LEADERS */

.leaders{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:14px;
    margin-bottom:15px;
}

.leader span{
    color:#71899d;
    font-size:11px;
    letter-spacing:1px;
}

.leader h3{
    margin-top:10px;
    font-size:22px;
}

/* PLAYERS */

.players{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:14px;
}

.player{
    min-height:135px;
}

.number{
    color:#80cfff;
    font-weight:bold;
}

.player h3{
    margin-top:10px;
}

.position{
    color:#7e96a9;
    margin-top:4px;
    font-size:12px;
}

.role{
    display:inline-block;
    margin-top:12px;
    padding:5px 8px;
    border:1px solid #29445c;
    border-radius:6px;
    color:#a8ddff;
    font-size:10px;
}

/* MATCHES */

.matches{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:14px;
}

.match{
    padding:22px;
}

.matchTop{
    display:flex;
    justify-content:space-between;
    color:#71899d;
    font-size:10px;
    margin-bottom:20px;
}

.teams{
    display:grid;
    grid-template-columns:1fr auto 1fr;
    text-align:center;
    align-items:center;
    gap:10px;
}

.team{
    font-weight:bold;
}

.score{
    font-size:23px;
    color:#bceaff;
}

/* RESULTS */

.result .score{
    color:#71dfac;
}

/* TABLE */

.tableBox{
    overflow:auto;
}

table{
    width:100%;
    border-collapse:collapse;
}

th,td{
    padding:14px;
    border-bottom:1px solid #172c3f;
    text-align:left;
}

th{
    color:#7890a3;
    font-size:10px;
}

/* NEWS */

.news{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:14px;
}

.news p{
    color:#8299aa;
    margin-top:10px;
    line-height:1.6;
    font-size:13px;
}

/* ADMIN */

.admin{
    display:none;
}

.admin.open{
    display:block;
}

.form{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:10px;
}

input,select{
    width:100%;
    padding:12px;
    border-radius:8px;
    border:1px solid #1c354b;
    background:#07111c;
    color:white;
    outline:none;
}

.full{
    grid-column:1/-1;
}

.adminSection{
    margin-top:30px;
    padding-top:25px;
    border-top:1px solid #1a3045;
}

.adminRow{
    display:flex;
    align-items:center;
    gap:10px;
    padding:12px 0;
    border-bottom:1px solid #172c3f;
}

.adminRow span{
    flex:1;
}

.remove{
    background:#291319;
    color:#ff9fa9;
    border:1px solid #5a2934;
    border-radius:7px;
    padding:8px 10px;
    cursor:pointer;
}

/* FOOTER */

footer{
    border-top:1px solid #152b3e;
    text-align:center;
    padding:35px;
    color:#71899d;
    font-size:11px;
}

/* MOBILE */

@media(max-width:850px){

    .menu{
        display:none;
    }

    .hero{
        grid-template-columns:1fr;
        text-align:center;
    }

    .heroLogo{
        order:-1;
    }

    .heroLogo img{
        width:220px;
    }

    .heroText p{
        margin:auto;
    }

    .buttons{
        justify-content:center;
    }

    .stats,
    .players{
        grid-template-columns:1fr 1fr;
    }

    .matches,
    .news{
        grid-template-columns:1fr;
    }
}

@media(max-width:500px){

    .heroText h1{
        font-size:48px;
    }

    .stats,
    .players,
    .leaders{
        grid-template-columns:1fr;
    }

    .form{
        grid-template-columns:1fr;
    }

    .full{
        grid-column:auto;
    }
}
</style>
</head>

<body>

<!-- NAVBAR -->

<nav>
<div class="nav">

<a class="logo" href="#home">
<img src="logo.png">
<span>FROZEN STORM CLUB</span>
</a>

<div class="menu">
<a href="#team">Team</a>
<a href="#matches">Matches</a>
<a href="#results">Results</a>
<a href="#stats">Stats</a>
<a href="#news">News</a>
<a href="#admin">Admin</a>
</div>

</div>
</nav>


<!-- HERO -->

<header class="hero" id="home">

<div class="heroText">

<small>OFFICIAL FOOTBALL CLUB</small>

<h1>
FROZEN<br>
STORM
</h1>

<p>
Welcome to the official Frozen Storm Club website.
Follow our squad, captains, fixtures, results and player statistics.
</p>

<div class="buttons">
<a href="#team" class="btn primary">View Team</a>
<a href="#matches" class="btn">Fixtures</a>
</div>

</div>

<div class="heroLogo">
<img src="logo.png" alt="Frozen Storm Club">
</div>

</header>


<!-- OVERVIEW -->

<section>

<div class="title">
<h2>Season Overview</h2>
<p>Frozen Storm Club · 2026</p>
</div>

<div class="stats">

<div class="card stat">
<strong id="matchesCount">0</strong>
<span>Matches</span>
</div>

<div class="card stat">
<strong id="winsCount">0</strong>
<span>Wins</span>
</div>

<div class="card stat">
<strong id="goalsCount">0</strong>
<span>Goals</span>
</div>

<div class="card stat">
<strong id="playersCount">0</strong>
<span>Players</span>
</div>

</div>

</section>


<!-- TEAM -->

<section id="team">

<div class="title">
<h2>Team Information</h2>
<p>First team leadership and squad</p>
</div>

<div class="leaders">

<div class="card leader">
<span>CAPTAIN</span>
<h3 id="captain">No Captain</h3>
</div>

<div class="card leader">
<span>VICE CAPTAIN</span>
<h3 id="viceCaptain">No Vice Captain</h3>
</div>

</div>

<div class="players" id="players"></div>

</section>


<!-- MATCHES -->

<section id="matches">

<div class="title">
<h2>Upcoming Matches</h2>
<p>Next fixtures</p>
</div>

<div class="matches" id="upcomingMatches"></div>

</section>


<!-- RESULTS -->

<section id="results">

<div class="title">
<h2>Results</h2>
<p>Latest completed matches</p>
</div>

<div class="matches" id="resultsList"></div>

</section>


<!-- STATS -->

<section id="stats">

<div class="title">
<h2>Player Statistics</h2>
<p>Season performance</p>
</div>

<div class="card tableBox">

<table>

<thead>

<tr>
<th>PLAYER</th>
<th>GOALS</th>
<th>ASSISTS</th>
<th>MATCHES</th>
<th>RATING</th>
</tr>

</thead>

<tbody id="statsTable"></tbody>

</table>

</div>

</section>


<!-- NEWS -->

<section id="news">

<div class="title">
<h2>Club News</h2>
<p>Latest updates</p>
</div>

<div class="news">

<div class="card">
<strong>Frozen Storm Club</strong>
<p>
The official club website is now live.
</p>
</div>

<div class="card">
<strong>Squad</strong>
<p>
Manage players, captains and team information from the dashboard.
</p>
</div>

<div class="card">
<strong>Matchday</strong>
<p>
Upcoming fixtures and final results are displayed here.
</p>
</div>

</div>

</section>


<!-- ADMIN -->

<section id="admin">

<div class="title">

<h2>Club Admin</h2>
<p>Manage your club</p>

<button class="btn primary"
onclick="toggleAdmin()"
style="margin-top:15px">
Open Admin Panel
</button>

</div>


<div class="admin" id="adminPanel">


<!-- ADD PLAYER -->

<div class="card">

<h3>Add Player</h3>

<div class="form" style="margin-top:15px">

<input id="playerName"
placeholder="Player name">

<input id="playerNumber"
type="number"
placeholder="Number">

<select id="playerPosition">

<option>GK</option>
<option>DF</option>
<option>MF</option>
<option>FW</option>

</select>

<select id="playerRole">

<option>Player</option>
<option>Captain</option>
<option>Vice Captain</option>

</select>

<input id="playerGoals"
type="number"
placeholder="Goals"
value="0">

<input id="playerAssists"
type="number"
placeholder="Assists"
value="0">

<input id="playerMatches"
type="number"
placeholder="Matches"
value="0">

<input id="playerRating"
type="number"
step="0.1"
placeholder="Rating"
value="0">

<button class="btn primary full"
onclick="addPlayer()">

Add Player

</button>

</div>

</div>


<!-- PLAYERS -->

<div class="card adminSection">

<h3>Players</h3>

<div id="adminPlayers"></div>

</div>


<!-- ADD MATCH -->

<div class="card adminSection">

<h3>Add Match</h3>

<div class="form" style="margin-top:15px">

<input id="matchOpponent"
placeholder="Opponent">

<input id="matchDate"
placeholder="Date / Time">

<select id="matchType">

<option>League</option>
<option>Friendly</option>
<option>Cup</option>
<option>Tournament</option>

</select>

<button class="btn primary full"
onclick="addMatch()">

Add Match

</button>

</div>

</div>


<!-- MATCHES ADMIN -->

<div class="card adminSection">

<h3>Matches</h3>

<div id="adminMatches"></div>

</div>


<!-- ADD RESULT -->

<div class="card adminSection">

<h3>Add Result</h3>

<div class="form" style="margin-top:15px">

<input id="resultOpponent"
placeholder="Opponent">

<input id="resultDate"
placeholder="Date">

<input id="resultGoals"
type="number"
placeholder="Frozen Storm Goals">

<input id="resultOpponentGoals"
type="number"
placeholder="Opponent Goals">

<button class="btn primary full"
onclick="addResult()">

Add Result

</button>

</div>

</div>


<!-- RESULTS ADMIN -->

<div class="card adminSection">

<h3>Results</h3>

<div id="adminResults"></div>

</div>


<!-- CAPTAIN -->

<div class="card adminSection">

<h3>Captain Management</h3>

<div class="form" style="margin-top:15px">

<select id="captainSelect">
<option value="">Select Player</option>
</select>

<button class="btn primary"
onclick="addCaptain()">

Add Captain

</button>

<button class="btn"
onclick="removeCaptain()">

Remove Captain

</button>

</div>

</div>


<!-- VICE CAPTAIN -->

<div class="card adminSection">

<h3>Vice Captain Management</h3>

<div class="form" style="margin-top:15px">

<select id="viceSelect">
<option value="">Select Player</option>
</select>

<button class="btn primary"
onclick="addViceCaptain()">

Add Vice Captain

</button>

<button class="btn"
onclick="removeViceCaptain()">

Remove Vice Captain

</button>

</div>

</div>

</div>

</section>


<footer>

Frozen Storm Club · Official Website · 2026

</footer>


<script>

/* =========================
   DATA
========================= */

let players =
JSON.parse(localStorage.getItem("fsc_players")) || [];

let matches =
JSON.parse(localStorage.getItem("fsc_matches")) || [];

let results =
JSON.parse(localStorage.getItem("fsc_results")) || [];

let captain =
localStorage.getItem("fsc_captain") || "";

let viceCaptain =
localStorage.getItem("fsc_vice") || "";


/* =========================
   SAVE
========================= */

function save(){

localStorage.setItem(
"fsc_players",
JSON.stringify(players)
);

localStorage.setItem(
"fsc_matches",
JSON.stringify(matches)
);

localStorage.setItem(
"fsc_results",
JSON.stringify(results)
);

localStorage.setItem(
"fsc_captain",
captain
);

localStorage.setItem(
"fsc_vice",
viceCaptain
);

}


/* =========================
   ADMIN TOGGLE
========================= */

function toggleAdmin(){

document
.getElementById("adminPanel")
.classList.toggle("open");

}


/* =========================
   ESCAPE HTML
========================= */

function safe(text){

return String(text)
.replaceAll("&","&amp;")
.replaceAll("<","&lt;")
.replaceAll(">","&gt;")
.replaceAll('"',"&quot;")
.replaceAll("'","&#039;");

}


/* =========================
   ADD PLAYER
========================= */

function addPlayer(){

let name =
document.getElementById("playerName").value.trim();

if(!name){

alert("Enter player name");

return;

}

players.push({

name:name,

number:
document.getElementById("playerNumber").value,

position:
document.getElementById("playerPosition").value,

role:
document.getElementById("playerRole").value,

goals:
Number(document.getElementById("playerGoals").value) || 0,

assists:
Number(document.getElementById("playerAssists").value) || 0,

matches:
Number(document.getElementById("playerMatches").value) || 0,

rating:
Number(document.getElementById("playerRating").value) || 0

});

save();

render();

document.getElementById("playerName").value="";

}


/* =========================
   REMOVE PLAYER
========================= */

function removePlayer(index){

let player=players[index];

if(!confirm("Remove "+player.name+"?"))
return;

if(captain===player.name)
captain="";

if(viceCaptain===player.name)
viceCaptain="";

players.splice(index,1);

save();

render();

}


/* =========================
   ADD MATCH
========================= */

function addMatch(){

let opponent =
document.getElementById("matchOpponent")
.value.trim();

let date =
document.getElementById("matchDate")
.value.trim();

let type =
document.getElementById("matchType")
.value;

if(!opponent){

alert("Enter opponent");

return;

}

matches.push({

opponent:opponent,

date:date,

type:type

});

save();

render();

document.getElementById("matchOpponent").value="";

document.getElementById("matchDate").value="";

}


/* =========================
   REMOVE MATCH
========================= */

function removeMatch(index){

if(!confirm("Remove this match?"))
return;

matches.splice(index,1);

save();

render();

}


/* =========================
   ADD RESULT
========================= */

function addResult(){

let opponent =
document.getElementById("resultOpponent")
.value.trim();

let date =
document.getElementById("resultDate")
.value.trim();

let goals =
Number(document.getElementById("resultGoals").value);

let opponentGoals =
Number(document.getElementById("resultOpponentGoals").value);

if(!opponent){

alert("Enter opponent");

return;

}

results.push({

opponent:opponent,

date:date,

goals:goals || 0,

opponentGoals:opponentGoals || 0

});

save();

render();

document.getElementById("resultOpponent").value="";

document.getElementById("resultDate").value="";

}


/* =========================
   REMOVE RESULT
========================= */

function removeResult(index){

if(!confirm("Remove this result?"))
return;

results.splice(index,1);

save();

render();

}


/* =========================
   CAPTAIN
========================= */

function addCaptain(){

let select =
document.getElementById("captainSelect");

let name=select.value;

if(!name){

alert("Select a player");

return;

}

captain=name;

save();

render();

}


/* =========================
   REMOVE CAPTAIN
========================= */

function removeCaptain(){

captain="";

save();

render();

}


/* =========================
   VICE CAPTAIN
========================= */

function addViceCaptain(){

let name =
document.getElementById("viceSelect").value;

if(!name){

alert("Select a player");

return;

}

viceCaptain=name;

save();

render();

}


/* =========================
   REMOVE VICE
========================= */

function removeViceCaptain(){

viceCaptain="";

save();

render();

}


/* =========================
   RENDER
========================= */

function render(){

/* PLAYERS */

document.getElementById("players").innerHTML =

players.map((p)=>`

<div class="card player">

<div class="number">
#${safe(p.number || "-")}
</div>

<h3>
${safe(p.name)}
</h3>

<div class="position">
${safe(p.position)}
</div>

${
p.role !== "Player"
?
`<span class="role">${safe(p.role)}</span>`
:
""
}

</div>

`).join("");


/* STATS TABLE */

document.getElementById("statsTable").innerHTML =

players.map((p)=>`

<tr>

<td>${safe(p.name)}</td>

<td>${p.goals}</td>

<td>${p.assists}</td>

<td>${p.matches}</td>

<td>${p.rating}</td>

</tr>

`).join("");


/* CAPTAINS */

document.getElementById("captain")
.textContent =
captain || "No Captain";

document.getElementById("viceCaptain")
.textContent =
viceCaptain || "No Vice Captain";


/* SELECTS */

let options =
`<option value="">Select Player</option>`+

players.map(p=>

`<option value="${safe(p.name)}">
${safe(p.name)}
</option>`

).join("");

document.getElementById("captainSelect")
.innerHTML=options;

document.getElementById("viceSelect")
.innerHTML=options;


/* UPCOMING MATCHES */

document.getElementById("upcomingMatches").innerHTML =

matches.length ?

matches.map(m=>`

<div class="card match">

<div class="matchTop">

<span>${safe(m.type)}</span>

<span>${safe(m.date)}</span>

</div>

<div class="teams">

<div class="team">
Frozen Storm
</div>

<div class="score">
VS
</div>

<div class="team">
${safe(m.opponent)}
</div>

</div>

</div>

`).join("")

:

`<div class="card">
No upcoming matches.
</div>`;


/* RESULTS */

document.getElementById("resultsList").innerHTML =

results.length ?

results.map(r=>`

<div class="card match result">

<div class="matchTop">

<span>FINAL</span>

<span>${safe(r.date)}</span>

</div>

<div class="teams">

<div class="team">
Frozen Storm
</div>

<div class="score">
${r.goals} - ${r.opponentGoals}
</div>

<div class="team">
${safe(r.opponent)}
</div>

</div>

</div>

`).join("")

:

`<div class="card">
No results yet.
</div>`;


/* ADMIN PLAYERS */

document.getElementById("adminPlayers").innerHTML =

players.map((p,i)=>`

<div class="adminRow">

<span>

<b>
#${safe(p.number || "-")}
${safe(p.name)}
</b>

<br>

<small style="color:#71899d">
${safe(p.position)} · ${safe(p.role)}
</small>

</span>

<button
class="remove"
onclick="removePlayer(${i})">

Remove

</button>

</div>

`).join("");


/* ADMIN MATCHES */

document.getElementById("adminMatches").innerHTML =

matches.map((m,i)=>`

<div class="adminRow">

<span>

<b>
Frozen Storm vs ${safe(m.opponent)}
</b>

<br>

<small style="color:#71899d">
${safe(m.date)} · ${safe(m.type)}
</small>

</span>

<button
class="remove"
onclick="removeMatch(${i})">

Remove

</button>

</div>

`).join("");


/* ADMIN RESULTS */

document.getElementById("adminResults").innerHTML =

results.map((r,i)=>`

<div class="adminRow">

<span>

<b>
Frozen Storm ${r.goals} - ${r.opponentGoals}
${safe(r.opponent)}
</b>

<br>

<small style="color:#71899d">
${safe(r.date)}
</small>

</span>

<button
class="remove"
onclick="removeResult(${i})">

Remove

</button>

</div>

`).join(""
